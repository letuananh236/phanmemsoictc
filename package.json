{
  "name": "phanmemsoictc",
  "version": "1.1.0",
  "description": "Ứng dụng tạo phiếu khám bệnh với khả năng chụp hình và in khổ A4",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "node src/app.js",
    "build": "node scripts/build.js",
    "deploy": "npm run build && gh-pages -d dist",
    "test": "node --test",
    "electron:start": "electron .",
    "electron:build": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^25.1.8",
    "gh-pages": "^6.1.1"
  },
  "build": {
    "appId": "com.soitc.phieukham",
    "productName": "PhanMemSoICTC",
    "files": [
      "electron/**/*",
      "src/**/*",
      "public/**/*",
      "database/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    }
  }
}
