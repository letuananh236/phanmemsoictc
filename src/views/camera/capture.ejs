<section class="camera-page">
  <h1>Camera chụp ảnh</h1>

  <div class="camera-top-info">
    <span><strong>Exam ID:</strong> <%= examId || 'Chế độ thử' %></span>
  </div>

  <div class="camera-main">
    <aside class="camera-left-panel">
      <h2>Thiết bị & điều khiển</h2>

      <div class="form-group">
        <label>Chọn camera</label>
        <select id="cameraDeviceSelect"></select>
      </div>

      <div class="camera-config-buttons">
        <button type="button" id="btnSaveDefaultCamera" class="btn btn-secondary">Lưu camera đang dùng</button>
        <button type="button" id="btnOpenCameraConfig" class="btn btn-secondary">Cấu hình camera</button>
      </div>

      <div class="form-group">
        <button type="button" id="btnCapture" class="btn btn-primary">Chụp hình</button>
      </div>

      <div class="camera-selected">
        <h3>Ảnh đã chọn</h3>
        <div id="selectedThumbnails" class="camera-selected-grid"></div>
        <form id="confirmForm" method="POST" action="/camera/<%= examId || 'session' %>/confirm">
          <input type="hidden" name="selectedImages" id="selectedImageIds" />
          <div class="camera-selected-actions">
            <button type="button" id="btnAcceptImages" class="btn btn-success">Chấp nhận (F10)</button>
            <button type="button" id="btnClearImages" class="btn btn-danger-outline">Xóa toàn bộ ảnh</button>
          </div>
        </form>
      </div>
    </aside>

    <section class="camera-preview">
      <video id="cameraVideo" autoplay playsinline></video>
      <canvas id="cameraCanvas" style="display:none;"></canvas>
    </section>
  </div>

  <section class="camera-bottom">
    <div class="camera-captured-header">
      <h2>Ảnh đã chụp</h2>
      <span class="camera-note">Nhấp vào ảnh để chọn (tối đa 4 ảnh).</span>
    </div>
    <div id="capturedGrid" class="camera-captured-grid"></div>
    <div class="camera-paging">
      <button type="button" id="btnPrevPage" class="btn btn-light">&laquo;</button>
      <button type="button" id="btnNextPage" class="btn btn-light">&raquo;</button>
    </div>
  </section>
</section>

<script>
  window.cameraPageData = {
    examId: "<%= examId || '' %>",
    images: <%- JSON.stringify(images || []) %>
  };
</script>
<script src="/public/js/camera.js"></script>
