<template id="tpl-exam-detail">
  <div class="detail-wrapper">
    <h4>Chi tiết phiếu</h4>
    <div class="toolbar detail-actions">
      <button type="button" data-action="print">In lại phiếu</button>
      <button type="button" class="secondary" data-action="edit">Sửa phiếu</button>
    </div>
    <div class="detail-grid">
      <div><strong>Mã phiếu:</strong> ...</div>
      <div><strong>Ngày khám:</strong> ...</div>
      <div><strong>Họ và tên:</strong> ...</div>
      <div><strong>Tuổi / Giới tính:</strong> ...</div>
      <div><strong>Địa chỉ:</strong> ...</div>
      <div><strong>SĐT:</strong> ...</div>
      <div><strong>Chẩn đoán lâm sàng:</strong> ...</div>
      <div><strong>Chỉ định:</strong> ...</div>
      <div><strong>Bác sỹ chỉ định:</strong> ...</div>
      <div><strong>Kết quả:</strong> ...</div>
    </div>
    <div class="detail-block">
      <div class="detail-label">Mô tả</div>
      <pre class="detail-text"></pre>
    </div>
    <div class="detail-block">
      <div class="detail-label">Các bước điều trị</div>
      <pre class="detail-text"></pre>
    </div>
    <div class="detail-block">
      <div class="detail-label">Lời dặn của bác sỹ</div>
      <pre class="detail-text"></pre>
    </div>
    <div class="image-grid"></div>
  </div>
</template>
