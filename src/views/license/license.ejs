<section class="panel">
  <h2>Bản quyền</h2>
  <% if (message) { %><div class="alert"><%= message %></div><% } %>
  <p>Trạng thái: <%= status ? status.status : 'Chưa kích hoạt' %></p>
  <form method="post">
    <label>License key</label>
    <input name="license_key" required>
    <button class="btn btn-primary" type="submit">Kích hoạt</button>
  </form>
</section>
