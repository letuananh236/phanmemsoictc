<section class="panel">
  <h2>Bản quyền phần mềm</h2>
  <% if (message) { %>
    <div class="alert"><%= message %></div>
  <% } %>
  <div class="license-status">
    <p><strong>License key hiện tại:</strong> <%= status && status.license_key ? status.license_key : 'Chưa có' %></p>
    <p><strong>Phiên bản:</strong> <%= status && status.edition ? status.edition : 'N/A' %></p>
    <p><strong>Hết hạn:</strong> <%= status && status.expire_date ? status.expire_date : 'Chưa xác định' %></p>
    <p><strong>Trạng thái:</strong> <%= status && status.status ? status.status : 'Chưa kích hoạt' %></p>
  </div>
  <form method="POST" action="/license" class="form-grid">
    <label for="key">License key</label>
    <input id="key" type="text" name="key" placeholder="Nhập key vào đây" required />
    <button class="btn btn-primary" type="submit">Lưu key</button>
  </form>
</section>
